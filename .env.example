# Multi-Agent ESP32 Orchestration System
# Copy this file to .env and fill in your values.

# API authentication (leave empty to disable)
API_KEY=

# CORS origins (comma-separated, leave empty for wildcard in dev)
CORS_ORIGINS=

# AI provider (Groq)
GROQ_API_KEY=

# Database (Neon PostgreSQL)
DATABASE_URL=

# Cloud connectors
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# GCP_PROJECT_ID=
# AZURE_IOT_CONNECTION_STRING=

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

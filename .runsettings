<?xml version="1.0" encoding="utf-8"?>
<!-- .runsettings — Visual Studio / dotnet test run configuration
     Reference: https://learn.microsoft.com/visualstudio/test/configure-unit-tests-by-using-a-dot-runsettings-file -->
<RunSettings>

  <!-- ── Test runner ────────────────────────────────────────────────────── -->
  <RunConfiguration>
    <!-- Maximum time (ms) for a single test. 0 = no limit. -->
    <TestSessionTimeout>120000</TestSessionTimeout>
    <TestTimeout>30000</TestTimeout>

    <!-- Collect code coverage via coverlet when running in VS -->
    <ResultsDirectory>TestResults</ResultsDirectory>
  </RunConfiguration>

  <!-- ── Code coverage (coverlet / VS built-in) ─────────────────────────── -->
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage"
                     uri="datacollector://Microsoft/CodeCoverage/2.0"
                     assemblyQualifiedName="Microsoft.VisualStudio.Coverage.CoveragePlugin">
        <Configuration>
          <CodeCoverage>
            <ModulePaths>
              <Exclude>
                <ModulePath>.*\.Tests\.dll$</ModulePath>
              </Exclude>
            </ModulePaths>
            <UseVerifiableInstrumentation>True</UseVerifiableInstrumentation>
            <AllowLowIntegrityProcesses>True</AllowLowIntegrityProcesses>
            <CollectFromChildProcesses>True</CollectFromChildProcesses>
            <CollectAspDotNet>False</CollectAspDotNet>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>

  <!-- ── Roslyn analyser / logger settings ─────────────────────────────── -->
  <LoggerRunSettings>
    <Loggers>
      <Logger friendlyName="console" enabled="True">
        <Configuration>
          <Verbosity>normal</Verbosity>
        </Configuration>
      </Logger>
      <Logger friendlyName="trx" enabled="False">
        <Configuration>
          <LogFileName>TestResults.trx</LogFileName>
        </Configuration>
      </Logger>
    </Loggers>
  </LoggerRunSettings>

</RunSettings>

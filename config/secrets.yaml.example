# secrets.yaml.example — copy to secrets.yaml and fill in your values.
#
# ⚠  secrets.yaml is listed in .gitignore — never commit real keys.
#
# Alternatively, every field below can be set via the corresponding
# environment variable (useful for containers and CI).  Env vars take
# precedence over this file.
#
# Structure mirrors config/default.yaml; only sensitive fields are listed here.

# ---------------------------------------------------------------------------
# AI agent — CHAiMERA3sp provider keys
# ---------------------------------------------------------------------------
ai_agent:
  chaimera3sp:
    providers:
      watsonx:
        api_key: ""          # env: WATSONX_API_KEY
        project_id: ""       # env: WATSONX_PROJECT_ID

      kimi:
        api_key: ""          # env: KIMI_API_KEY

      kai9000:
        api_key: ""          # env: KAI9000_API_KEY

      manus:
        api_key: ""          # env: MANUS_API_KEY

# ---------------------------------------------------------------------------
# Communications agent — cloud connector credentials
# ---------------------------------------------------------------------------
comms_agent:
  api_key: ""                # env: CLOUD_API_KEY  (HTTP connector bearer token)
  azure_connection_string: "" # env: AZURE_CONNECTION_STRING
